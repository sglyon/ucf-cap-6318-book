odel)\n        self.wealth = 1\n\n    def step(self):\n        wealth_in_space_step(self)","key":"lpIfEKK5iS"},{"type":"outputs","id":"_INfWr5rJtNQr0ZRo-Hdf","children":[],"key":"lOiceUdrIY"}],"key":"EzZjO0j869"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-20T02:57:53.249015Z","iopub.status.busy":"2026-08-20T02:57:53.248906Z","iopub.status.idle":"2026-08-20T02:57:53.251603Z","shell.execute_reply":"2026-08-20T02:57:53.250990Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def wealth_in_space_step(agent):\n    if agent.wealth == 0:\n        return\n\n    neighbors = agent.model.grid.get_neighbors(agent.pos, moore=True, include_center=False)\n    if not neighbors:\n        return\n\n    recipient = agent.model.random.choice(neighbors)\n    agent.wealth -= 1\n    recipient.wealth += 1","key":"QtB4mVdzPH"},{"type":"outputs","id":"pJCKlHGxIRH01-AReZcBO","children":[],"key":"EC9dJEuV33"}],"key":"POs1O1Oq2c"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-20T02:57:53.252819Z","iopub.status.busy":"2026-08-20T02:57:53.252712Z","iopub.status.idle":"2026-08-20T02:57:53.256444Z","shell.execute_reply":"2026-08-20T02:57:53.255777Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import itertools\n\n\nclass MoneyModel2D(mesa.Model):\n    def __init__(self, dims=(25, 25), rng=None):\n        super().__init__(rng=rng)\n        width, height = dims\n        # periodic=True (torus=True) means agents at edges can interact with agents on\n        # the opposite edge. This creates a torus topology - think of it like Pac-Man\n        # where going off one side brings you to the other side.\n        self.grid = mesa.space.MultiGrid(width, height, torus=True)\n\n        for pos in itertools.product(range(width), range(height)):\n            agent = WealthInSpace(self)\n            self.grid.place_agent(agent, pos)\n\n        self.datacollector = mesa.DataCollector(agent_reporters={\"wealth\": \"wealth\", \"pos\": \"pos\"})\n        self.datacollector.collect(self)\n\n    def step(self):\n        self.agents.shuffle_do(\"step\")\n        self.datacollector.collect(self)","key":"cZlzmfv0Gp"},{"type":"outputs","id":"XyVJe_oB33QD2Nfaj7Whl","children":[],"key":"EiSlFeYXNr"}],"key":"U6Oyc5vEde"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-20T02:57:53.257676Z","iopub.status.busy":"2026-08-20T02:57:53.257565Z","iopub.status.idle":"2026-08-20T02:57:53.284982Z","shell.execute_reply":"2026-08-20T02:57:53.284225Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"m2d = MoneyModel2D(rng=6318)\nfor _ in range(10):\n    m2d.step()\n\ndf2d = m2d.datacollector.get_agent_vars_dataframe()","key":"Dl1hXccVm9"},{"type":"outputs","id":"bqrGcuwsg_YTWytHu43Zi","children":[],"key":"NNoKT4cpPk"}],"key":"TbUrdsZfLB"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-20T02:57:53.286331Z","iopub.status.busy":"2026-08-20T02:57:53.286223Z","iopub.status.idle":"2026-08-20T02:57:53.461812Z","shell.execute_reply":"2026-08-20T02:57:53.461317Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"final_wealth_2d = df2d.xs(10, level=\"Step\")[\"wealth\"]\ncounts, bin_edges = np.histogram(final_wealth_2d, bins=range(0, 10))\ncmap = plt.get_cmap(\"viridis\")\ncolors = [cmap(i / (len(counts) - 1)) for i in range(len(counts))]\n\nfig, ax = plt.subplots()\nax.bar(bin_edges[:-1], counts, width=1, align=\"edge\", color=colors, edgecolor=\"black\")\nax.set_xlabel(\"wealth\")\nax.set_ylabel(\"count\")\nfig","key":"G3jpxbc7YK"},{"type":"outputs","id":"opO8maytTDT3oySW1lVd6","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":12,"metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b88b1bead3e16b81557850869c39f375","path":"/build/b88b1bead3e16b81557850869c39f375.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"ofUiRVBrki"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b88b1bead3e16b81557850869c39f375","path":"/build/b88b1bead3e16b81557850869c39f375.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"G27c6k9mgh"}],"key":"AtcRKfpbsl"}],"key":"dpCOlU6geR"},{"type":"block","kind":"notebook-content","children":[{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Still a power law... very pervasive!","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"paJmKuB8w4"}],"key":"hD5C8AEtXa"}],"key":"hhc1m9RGtV"}],"key":"rHKETNtGQH"}],"key":"ZbqoE105KI"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-20T02:57:53.463264Z","iopub.status.busy":"2026-08-20T02:57:53.463146Z","iopub.status.idle":"2026-08-20T02:57:53.466233Z","shell.execute_reply":"2026-08-20T02:57:53.465863Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def make_heatmap(model, df, T=None):\n    if T is None:\n        T = df.index.get_level_values(\"Step\").max()\n    df_T = df.xs(T, level=\"Step\")\n\n    width, height = model.grid.width, model.grid.height\n    arr = np.zeros((width, height))\n    for pos, wealth in zip(df_T[\"pos\"], df_T[\"wealth\"]):\n        arr[pos] += wealth\n\n    fig, ax = plt.subplots(figsize=(6, 4.5))\n    im = ax.imshow(arr.T, origin=\"lower\", cmap=\"viridis\")\n    ax.set_title(f\"T = {T}\")\n    fig.colorbar(im, ax=ax)\n    return fig","key":"fhTV2OvOha"},{"type":"outputs","id":"qHzjuwqfH77wIx5Z5rsSu","children":[],"key":"XJB5gvvcV7"}],"key":"vfAJkv7gdC"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-08-20T02:57:53.467436Z","iopub.status.busy":"2026-08-20T02:57:53.467309Z","iopub.status.idle":"2026-08-20T02:57:54.434341Z","shell.execute_reply":"2026-08-20T02:57:54.433833Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for t in range(11):\n    make_heatmap(m2d, df2d, t)\n    plt.show()","key":"LFm75lZyNa"},{"type":"outputs","id":"wK4-RJOzmrOwYR4r-nUAW","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"3c6d2c59fb80e5b78102e2454f3b72b1","path":"/build/3c6d2c59fb80e5b78102e2454f3b72b1.png"},"text/plain":{"content":"<Figure size 600x450 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"Zv7F1Lxm8q"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b3cc5f78a7c21bf4980792d6eee2c1f4","path":"/build/b3cc5f78a7c21bf4980792d6eee2c1f4.png"},"text/plain":{"content":"<Figure size 600x450 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"hmgtnO5vBs"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d069ebf440ac9eee6c8c02fc652c7070","path":"/build/d069ebf440ac9eee6c8c02fc652c7070.png"},"text/plain":{"content":"<Figure size 600x450 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"MZVszmkgM8"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"aab34e5378efe48be4788af2db6edc11","path":"/build/aab34e5378efe48be4788af2db6edc11.png"},"text/plain":{"content":"<Figure size 600x450 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"CBek1M3u9w"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{